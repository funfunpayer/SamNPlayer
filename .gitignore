# Wails-/Frontend-Abhängigkeiten und Build-Artefakte
cmd/gui-wails/frontend/node_modules/
cmd/gui-wails/frontend/dist/
cmd/gui-wails/build/bin/

# Fertige Binaries. Bewusst NICHT eingecheckt: sie sind mehrere MB groß,
# ändern sich bei jedem Build komplett und werden vom Release-Workflow
# ohnehin automatisch gebaut und an den GitHub-Release gehängt.
dist/
*.exe

# Python
__pycache__/
*.pyc
.venv/
venv/

# Lokale Testartefakte
*.funscript
!testdata/**/*.funscript
!cmd/gui-wails/frontend/test/fixtures/*.funscript
*.mp4
!testdata/**/*.mp4

# Editor/OS
.DS_Store
.idea/
.vscode/
*.swp
